# CampusPilot Frontend Environment Configuration
# Local development backend:
VITE_AUTOMATION_API_URL=http://localhost:8000

# When deploying on Vercel, set this environment variable in Vercel Project Settings > Environment Variables:
# VITE_AUTOMATION_API_URL=https://your-campus-pilot-backend.onrender.com

# Alternative supported variable names:
# VITE_API_BASE_URL=https://your-campus-pilot-backend.onrender.com
# VITE_BACKEND_URL=https://your-campus-pilot-backend.onrender.com
