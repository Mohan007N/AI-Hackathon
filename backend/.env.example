# ── Organizer Portal ──────────────────────────────────────────────────────────
# Official hackathon portal base URL (no trailing slash)
PORTAL_URL=https://portal.example.com

# Your team code provided by the organizers
TEAM_CODE=YOUR_TEAM_CODE_HERE

# ── OpenRouter LLM ────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Any model available on OpenRouter
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Frontend ──────────────────────────────────────────────────────────────────
# React dev server URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory for JSONL action logs (relative or absolute)
LOG_DIRECTORY=logs

# ── Browser ───────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# ── HTTP Client ───────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

