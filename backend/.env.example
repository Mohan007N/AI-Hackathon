# ── Organizer Portal ──────────────────────────────────────────────────────────
# Official hackathon portal base URL (no trailing slash)
PORTAL_URL=https://portal.example.com

# Your team code provided by the organizers
TEAM_CODE=YOUR_TEAM_CODE_HERE

# ── Groq LLM (High-Speed Provider) ───────────────────────────────────────────
LLM_PROVIDER=groq
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Frontend & CORS ───────────────────────────────────────────────────────────
# Allowed frontend URL (e.g., your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app
# Additional comma-separated CORS origins if needed
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ── Browser Automation ────────────────────────────────────────────────────────
# In local development: false (opens visible Chromium)
# On Render / cloud: true (runs headless on cloud server)
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000

# ── Server & Environment ──────────────────────────────────────────────────────
PORT=8000
APP_ENV=development
DEBUG=false
LOG_DIRECTORY=logs
DATABASE_PATH=data/tasks.db
