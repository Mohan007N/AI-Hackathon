# ── Organizer Portal ──────────────────────────────────────────────────────────
# Official hackathon portal base URL (no trailing slash)
PORTAL_URL=https://portal.example.com

# Your team code provided by the organizers
TEAM_CODE=YOUR_TEAM_CODE_HERE

# ── Groq LLM (High-Speed Provider) ───────────────────────────────────────────
LLM_PROVIDER=groq
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Frontend ──────────────────────────────────────────────────────────────────
# React dev server URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory for JSONL action logs (relative or absolute)
LOG_DIRECTORY=logs

# ── Browser ───────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# ── HTTP Client ───────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

